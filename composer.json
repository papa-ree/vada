{
    "name": "bale/vada",
    "description": "Inbox chat admin WhatsApp untuk tenant Bale CMS",
    "keywords": [
        "bale",
        "laravel",
        "vada",
        "chat"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "bale",
            "email": "ricky.romdhoni@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "bale/cms": "*",
        "bale/core": "*",
        "bale/wara": "*"
    },
    "autoload": {
        "psr-4": {
            "Bale\\Vada\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bale\\Vada\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bale\\Vada\\VadaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
